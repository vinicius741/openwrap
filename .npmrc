# Keep runtime deps nested under the ui/ workspace instead of hoisting them
# to the root node_modules/.
#
# OpenWrap is an npm workspace where `ui` depends on react/react-dom. Vite's
# resolve alias (ui/vite.config.ts) points "react"/"react-dom" at
# ./ui/node_modules/{react,react-dom}, and the config-regression tests assert
# those directories physically exist. With the default "hoisted" strategy npm
# dedupes react to the root, which silently breaks the alias and the UI build
# (the "blank white screen" bug this contract guards against).
#
# `nested` guarantees react/react-dom land in ui/node_modules/, matching the
# guarded invariant. The extra copies are dev-only and negligible for a hobby
# app.
install-strategy=nested
