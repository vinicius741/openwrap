{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build --workspace ui"
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": {
      "../target/release/openwrap-helper": null,
      "windows/install-openvpn.ps1": "install-openvpn.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
