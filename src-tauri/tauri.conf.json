{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenWrap",
  "identifier": "app.openwrap.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace ui",
    "beforeBuildCommand": "cargo build -p openwrap-helper --release && npm run build --workspace ui",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenWrap",
        "width": 1180,
        "height": 780,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/openwrap-helper": "openwrap-helper-bundled"
    },
    "macOS": {
      "entitlements": "OpenWrap.entitlements",
      "infoPlist": "Info.plist"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwRDcyNDE5Q0E3Q0Q4RjcKUldUMzJIektHU1RYc0lPODZMUzRiWkFVbVNtWjh4YmlJMTFKcjQxQlFDM09JVUlwTHFNcSszRDMK",
      "endpoints": [
        "https://github.com/vinicius741/openwrap/releases/latest/download/latest.json"
      ]
    }
  }
}
